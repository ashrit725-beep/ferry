{
  "name": "ferry-console",
  "version": "0.1.0",
  "private": true,
  "description": "Ferry operator console. Built into ../ferry/static and served by the gateway.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.64.0",
    "motion": "14.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
